# nbdpsy-mcp 环境变量样例。复制为 .env 并按需填入真实值。
# 每个字段对应 app/core/config.py 中的 Settings 字段（全部带默认值，可缺省）。

# 应用元信息
APP_NAME=nbdpsy-mcp
DEBUG=false
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# API 服务监听
API_HOST=0.0.0.0
API_PORT=8848
PUBLIC_BASE_URL=http://127.0.0.1:8848

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data/nbdpsy.db
# SQLite 忙等超时（秒）：并发写锁竞争时最多等待此秒数而非立即报 database is locked（仅 sqlite 生效）
SQLITE_BUSY_TIMEOUT=30

# 安全（生产必须替换为 >=32 字节随机值）
SECRET_KEY=change-me-32bytes-minimum-secret-key
ROOT_ADMIN_APIKEY=

# 数据/上传目录
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
# 图片上传:单张大小上限（MB）与批次保留天数
UPLOAD_MAX_MB=10
UPLOAD_TTL_DAYS=7

# 浏览器自动化（Xvfb 虚拟显示）
XVFB_DISPLAY=:99
# 全局浏览器并发闸：同时运行的 camoufox 数上限（超出排队等待）
BROWSER_CONCURRENCY=6

# 发布队列
PUBLISH_CONCURRENCY=2
PUBLISH_RETRY_SCHEDULE=120,600,1800
PUBLISH_JOB_TIMEOUT=600
# 账号级发布冷却(秒):同一账号两次发布最小间隔,每次 random.uniform(MIN,MAX) 现抽抖动
PUBLISH_MIN_INTERVAL_MIN=1200
PUBLISH_MIN_INTERVAL_MAX=3600
# 每账号每自然日发布上限:达上限的新任务顺延到次日活跃窗口
PUBLISH_DAILY_CAP=8
# 次日活跃窗口起点(UTC 小时,1=北京09:00)与抖动跨度(秒)
PUBLISH_ACTIVE_WINDOW_START_UTC_HOUR=1
PUBLISH_ACTIVE_WINDOW_JITTER_SEC=7200
# 视频/音频上传+平台转码的等待上限:基数 + 每 100MB 加时,封顶(秒)
VIDEO_UPLOAD_TIMEOUT_BASE_S=300
VIDEO_UPLOAD_TIMEOUT_PER_100MB_S=120
VIDEO_UPLOAD_TIMEOUT_CAP_S=3600
# 大媒体分片上传(视频/音频通用;隧道单请求 100MB 是分片的原因)
UPLOAD_CHUNK_MB=50
UPLOAD_MEDIA_MAX_MB=4096
UPLOAD_AUDIO_MAX_MB=1024
UPLOAD_SESSION_TTL_HOURS=24

# Cookie 巡检间隔（秒，0 表示关闭定时巡检）
COOKIE_CHECK_INTERVAL=0

# 新号接入调度：扫描间隔（秒，0 表示关闭）与同号自动检测的最短间隔（小时）。
# 有 cookie 却仍是 unknown 的号自动排一次检测，转 valid 后引导链接管；转正即出局。
ONBOARDING_CHECK_INTERVAL=300
ONBOARDING_CHECK_RETRY_HOURS=1

# 孤儿 camoufox 回收：巡检间隔（秒，0 表示关闭）与超龄阈值（秒）
BROWSER_REAP_INTERVAL=300
BROWSER_REAP_AGE=900

# 占位废账号根治：A 服务端自愈窗口（分钟）、B TTL 兜底 reaper 间隔（秒，0=关闭）与占位存活上限（小时）
PLACEHOLDER_CLEAN_WINDOW_MINUTES=30
PLACEHOLDER_REAP_INTERVAL=3600
PLACEHOLDER_TTL_HOURS=24

# 调试截图开关
# 调试截图保留天数(0=不清理);截图目录只增不减,实测过 1633 个/469MB
DEBUG_SCREENSHOT_RETENTION_DAYS=14
DEBUG_SCREENSHOTS_ENABLED=false

# 选择器自愈（可选，默认关）。开启需 SELFHEAL_ENABLED=true 且填 LLM_API_KEY
SELFHEAL_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-flash
LLM_TIMEOUT=15

# ── 视频管线：DashScope（ASR/翻译/LLM/VL 共用一把 apikey）──
# ASR 走 dashscope SDK 自带端点；翻译/LLM/VL 走下面的 compatible-mode（openai 兼容）base_url。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VIDEO_ASR_MODEL=paraformer-v2
# transport 下载时长闸门（秒，超此时长拒收；默认 2h）
VIDEO_TRANSPORT_MAX_DURATION_SECONDS=7200
VIDEO_MT_MODEL=qwen-mt-plus
VIDEO_LLM_MODEL=qwen3.7-plus
VIDEO_VL_MODEL=qwen3-vl-plus

# ── 视频管线：豆包语音 TTS（声音复刻 v3 / seed-icl-2.0）──
DOUBAO_TTS_APPID=
DOUBAO_TTS_TOKEN=
# 默认复刻音色（牧羊，实测自然度优于 cosyvoice）
DOUBAO_TTS_VOICE=S_hoiqVFN72
DOUBAO_TTS_RESOURCE_ID=seed-icl-2.0
# transport dub 全片统一语速上限（倍率；到顶仍溢出则接受残余+告警；默认 1.2）
TTS_MAX_RATE=1.2

# ── 一致性生图（gpt-image-2 锚点法，自薯营家迁移）──
# OpenAI Images API；BASE_URL 可指向国内中转，PROXY 非空再叠 HTTP 代理
OPENAI_IMAGE_API_KEY=
OPENAI_IMAGE_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
# 质量档：medium 为质量/成本平衡点（8 页约 $0.68）
OPENAI_IMAGE_QUALITY=medium
# 单张生图调用超时（秒）
OPENAI_IMAGE_TIMEOUT=300
# 建连超时（秒）：SDK 默认 connect 仅 5s，网络抖动时无缓冲即 "Request timed out."
OPENAI_IMAGE_CONNECT_TIMEOUT=30
# 上游超时重试次数（退避 5s/15s，与 429 预算分开计）
OPENAI_IMAGE_TIMEOUT_RETRIES=2
OPENAI_IMAGE_PROXY=
# 单批次内并发路数（有界）：决定一篇跑几波（9页10路=1波约50s）；与篇级并行相乘=上游总在飞
OPENAI_IMAGE_CONCURRENCY=10
# 进程级生图并发闸：封顶全进程在飞的上游图像请求（页级×篇级相乘的兜底，超出排队不拒绝）
OPENAI_IMAGE_GLOBAL_CONCURRENCY=100

# ── 内容资产库(content_archive）──
# 发布成功自动归档;取详情即刷新最后使用时间;超 TTL 天未使用自动删除
ARCHIVE_TTL_DAYS=90
ARCHIVE_REAP_INTERVAL=21600

# ── 咨询师推介引用推导(counselor_quote)──
# 「接待员联系方式」笔记 note_id(含二维码有违规风险,故集中在 NBDpsy 主号统一管理):
# 咨询师推介笔记引用它,是全系统唯一允许跨账号引用的一篇;留空=该规则不生效,不引用也不猜
RECEPTIONIST_CONTACT_NOTE_ID=

# ── 笔记数据定时采集(note_metrics_scheduler)──
# 扫描间隔秒(0=关);语义=每号每天最多自动采3次,失败等比退避1h→2h
NOTE_METRICS_INTERVAL=3600

# ── 出口链路自检(egress_guard)──
# 防代理重装覆盖掉 camoufox 直连规则致出国被风控踢登录；两级自检间隔秒(0=关)，默认6h
EGRESS_CHECK_INTERVAL=21600
SINGBOX_CONFIG_PATH=/opt/hysteria-client/singbox-tun.json

# ── 笔记核心目的回填(note_purpose)──
# 每轮回填最多开几次编辑页;调大 = 加快踩风控墙速度(同号一小时 5 次会话就被弹墙)
NOTE_PURPOSE_BACKFILL_LIMIT=3

# ── 历史笔记互动补量(interaction_backfill)──
# 每个互动方账号每天最多互动几篇 / 一次任务最多做几篇(超出留给下一轮)
# 调大 = 加快踩风控墙速度:补量是"对老笔记的集中互动",平台眼里最典型的补量特征
NOTE_INTERACTION_DAILY_LIMIT=20
NOTE_INTERACTION_ROUND_LIMIT=5
# 两个断路器(2026-08-13 事故):上面两道闸管"补得多快",管不了"白开多少次注定失败的会话"
# actor 熔断:最近 N 条台账行全是 error 就跳过这个号(一篇失败落两行,6 ≈ 连续三篇整篇失败)
# 半开探测:最新 error 距今超过这么多小时放行一轮(只做一篇);没有半开=熔断即死锁,永无复位机会
# 笔记熔断:一篇被 ≥K 个**有资格**(valid 且未被 actor 熔断)的不同号在主页里翻不到即移出候选
# 翻不到两种成因系统区分不了(平台屏蔽 / 主页里排太靠后超出滚动预算),都停调度交人判;
# **不自动恢复**——人工核实后手工清那篇 error 行即可重新入池。调大 K = 更保守、少误伤
INTERACTION_ACTOR_BREAKER_N=6
INTERACTION_ACTOR_BREAKER_COOLDOWN_H=12
INTERACTION_NOTE_BREAKER_ACTORS=3

# ── 发布后矩阵互动(matrix_interact)──
# 一条任务=一次浏览器会话,一次会话最多互动几篇(超出的排下一轮,不丢)
# 5 = 单轮预算 1200s 装得下 + 覆盖实测峰值发布量(一小时 4 篇);调大 = 会话开更久
MATRIX_INTERACT_ROUND_LIMIT=5
# 自动续跑扫描间隔秒(0=关);没有它存量补量只能靠人每天手动触发才跑得完
# 它不放宽任何闸:每轮只是问一次"还有得补吗",日上限/单轮上限/冷却/在途去重都在原处判
INTERACTION_BACKFILL_INTERVAL=1800

# ── 受众行为库(audience)──
# 采集调度总开关(kill switch):关掉只停采集,已入库数据与 5 个分析端点照常
# 扫描间隔秒,同时是每号的到期门槛;调小=每号更频繁开真号会话,直接顶到
# ACCOUNT_HOURLY_SESSION_CAP=4 那条风控红线上
AUDIENCE_SYNC_ENABLED=true
AUDIENCE_SYNC_INTERVAL=3600
# 潜客打分五维权重(JSON);⚠️ v1 启发式不是科学模型,转化回流数据到位后必须重标定
AUDIENCE_SCORE_WEIGHTS={"frequency":0.30,"cross_account":0.20,"recency":0.20,"depth":0.15,"relation":0.15}
# 分析端点是否默认剔除自家矩阵号(不剔的话"最活跃受众"永远是自家号互刷出来的量)
AUDIENCE_SELF_EXCLUDE=true

# ── 笔记台账保底同步(note_ledger_sync_scheduler)──
# 总开关(kill switch):关掉只停保底,发布钩子与手工触发照旧
# 扫描间隔秒(0=关):多久看一眼"有没有号该同步了",不是每号的同步频率
# 每号到期门槛秒:距上次同步超过这么久才轮到它(默认 12h);调小=更频繁开真号会话,
# 直接顶到 ACCOUNT_HOURLY_SESSION_CAP=4 那条风控红线上
LEDGER_SYNC_SCHEDULER_ENABLED=true
LEDGER_SYNC_SCAN_INTERVAL=600
LEDGER_SYNC_MIN_INTERVAL=43200

# ── 合集批量清理(note_collection_batch)──
# 移出一轮最多几篇:每篇是一次真「更新」提交(全量覆盖),比点赞收藏重,故比互动补量更保守
# 扫描一轮最多几篇:只开页读一眼合集区,零点击零提交,风险约等于浏览笔记,故可以放宽
NOTE_COLLECTION_REMOVE_ROUND_LIMIT=5
NOTE_COLLECTION_SCAN_ROUND_LIMIT=60

# ── 草稿箱周清理(draft_clean_scheduler)──
# 扫描间隔秒(0=关);语义=每号每7天清一次草稿箱(系统不用草稿,全是垃圾)
DRAFT_CLEAN_INTERVAL=86400

# ── 代管账号的笔记数量上限淘汰(retention_scheduler)──
# 总开关:0=只算不删(照常打分+落 retention_runs 审计,不建删除 job)。kill switch 兼观察窗
RETENTION_ENABLED=1
# 安全轨①宽限期天数:发布不足这么多天的笔记不参与淘汰(新笔记指标没成型,不设就天天误杀新内容)
RETENTION_GRACE_DAYS=7
# 安全轨③单日单号删除封顶:首次启用时库存可能远超上限,不封顶就是第一天大屠杀
RETENTION_DAILY_DELETE_MAX=5
# 五指标权重 JSON;打分前每指标在候选集内先 min-max 归一化,故权重之比即重要性之比
# 解析失败/取值非法一律回退默认并告警,绝不拿一份坏权重去删笔记
RETENTION_WEIGHTS={"views":1,"likes":2,"collects":3,"comments":3,"follows":5}
# 扫描间隔秒(0=关);每 UTC 日每号至多一轮,且必须等当日数据快照到位才跑
RETENTION_CHECK_INTERVAL=3600

# ── 视频 worker 调度（方案 C 独立 asyncio worker）──
# 单机 CPU 编码并发 1；阶段内 300s 周期 touch heartbeat_at；恢复扫描判僵死阈值 900s(15min)
VIDEO_WORKER_CONCURRENCY=1
VIDEO_HEARTBEAT_INTERVAL=300
VIDEO_STALE_TIMEOUT=900

# ── API/Worker 进程拆分 ──
# 进程角色：api=只挂 REST 路由；worker=只跑任务消费；all=兼跑（开发/测试/单进程小部署）
NBDPSY_ROLE=all
# 每 operator 未完成任务配额（达上限再提交返 429；admin 不受限）
OPERATOR_PENDING_QUOTA=30
# worker 调度中枢扫描 DB 队列周期（秒）
WORKER_SCAN_INTERVAL=5
# 单轮派发中每账号子进程最多携带的任务数
WORKER_BATCH_PER_ACCOUNT=3
# 账号子进程硬超时（秒，超时视作僵死强杀）
ACCOUNT_PROC_TIMEOUT=1800
# 同号一小时浏览器会话总闸（0=关闸）：达帽后系统自发任务延后派发
ACCOUNT_HOURLY_SESSION_CAP=4
# 同号一小时运营触发会话帽（0=只关这层）：运营放得比系统宽，但达帽后同样延后
ACCOUNT_HOURLY_OPERATOR_SESSION_CAP=12

# ── 即梦视频生成(dreamina clips)──
# CLI 绝对路径:systemd 进程 PATH 不含 ~/.local/bin,写全路径否则 worker 里必 FileNotFound
# 登录态在 CLI 自己的 ~/.dreamina_cli/(公司号一份),不进本文件
DREAMINA_BIN=/home/roots/.local/bin/dreamina
# 调度主循环周期秒(先 submit 全部 queued 再 poll 到期在飞任务)
CLIP_POLL_SECONDS=20
# 单条在飞任务两次 query_result 最小间隔秒(即梦排队常达数小时,查密了只是加锁竞争)
CLIP_QUERY_INTERVAL=60
# CLI 子命令超时秒(submit 只提交;query 成功时要下载 MP4)。超时一律不重提,防双扣积分
CLIP_SUBMIT_TIMEOUT=120
CLIP_QUERY_TIMEOUT=300
# 产物 MP4 保留天数(需求要求 >=7 天:一条片从生成到过审可能跨几天)
CLIP_TTL_DAYS=14
# 产物 TTL 巡检间隔秒(0=关闭)
CLIP_REAP_INTERVAL=21600
# 积分低水位(low_threshold_hit 判据,仅提示不拦截)
CLIP_CREDIT_LOW_WATERMARK=200
# 单次批量提交镜数上限 / 参考图单张大小上限 MB
CLIP_MAX_BATCH=50
CLIP_IMAGE_MAX_MB=15
# 参考视频单条大小上限 MB(multimodal2video 的 --video 输入;视频比图片大一到两个量级)
CLIP_VIDEO_MAX_MB=200
# 参考音频单条大小上限 MB(multimodal2video 的 --audio 输入)
CLIP_AUDIO_MAX_MB=50
